# 複製成 .env 後填入實際值（.env 已列在 .gitignore，不會進 repo）。
# 系統環境變數若有同名設定，會優先於 .env。

# 第一次啟動時自動建立的教練帳號
COACH_EMAIL=
COACH_PASSWORD=

# 沒設定會自動產生並存到 session_secret.txt
SESSION_SECRET_KEY=

# 教練紀錄工具（coaching-record-tool）整合端點，結尾不要加斜線
COACHING_TOOL_BASE_URL=https://admin.badmintonlemon.com
# 對應教練紀錄工具的 public_booking_api_token.txt
COACHING_TOOL_API_TOKEN=
