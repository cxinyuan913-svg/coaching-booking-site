# 複製成 .env 後填入實際值（.env 已列在 .gitignore，不會進 repo）。
# 系統環境變數若有同名設定，會優先於 .env。

# 第一次啟動時自動建立的教練帳號（資料庫裡已經有教練帳號就不會再建）
COACH_EMAIL=
COACH_PASSWORD=

# 登入 cookie 的簽章密鑰。本機沒設定會自動產生並存到 session_secret.txt；
# 雲端一定要設（容器重建時檔案會消失，所有人會被登出），可用下面指令產生：
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# 教練紀錄工具（coaching-record-tool）整合端點，結尾不要加斜線
COACHING_TOOL_BASE_URL=https://admin.badmintonlemon.com
# 對應教練紀錄工具的 public_booking_api_token.txt
COACHING_TOOL_API_TOKEN=

# 有新預約申請時發 Discord 通知（選填，沒設就不發）
DISCORD_WEBHOOK_URL=
